generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String               @id @default(uuid())
  username           String               @unique
  email              String?              @unique
  phone              String?
  passwordHash       String
  avatarUrl          String?
  isActive           Boolean              @default(true)
  mustChangePassword Boolean              @default(false)
  sessionVersion     Int                  @default(0)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  resetTokens        PasswordResetToken[]
  teacher            Teacher?
  roles              UserRole[]
}

model Role {
  id    Int        @id @default(autoincrement())
  code  RoleCode   @unique
  name  String
  users UserRole[]
}

model UserRole {
  userId String
  roleId Int
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model TermConfig {
  id        Int      @id @default(autoincrement())
  year      Int      @unique
  term1Date DateTime
  updatedAt DateTime @updatedAt
}

model Term {
  id               Int                  @id @default(autoincrement())
  year             Int
  termIndex        Int
  startDate        DateTime
  endDate          DateTime
  schedules        CourseSchedule[]
  endEnrollments   StudentEnrollment[]  @relation("EnrollmentEndTerm")
  startEnrollments StudentEnrollment[]  @relation("EnrollmentStartTerm")
  payments         StudentTermPayment[]
  termForceCloses  StudentTermForceClose[]
  startExtraFees   StudentExtraFee[]    @relation("ExtraFeeStartTerm")
  endExtraFees     StudentExtraFee[]    @relation("ExtraFeeEndTerm")

  @@unique([year, termIndex])
}

model Grade {
  id         Int            @id @default(autoincrement())
  name       String         @unique
  orderIndex Int            @default(0)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  courseFees CourseFee[]
  extraFees  ExtraFeeRate[]
  students   Student[]
}

model School {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  students  Student[]
}

model GuardianType {
  id        Int               @id @default(autoincrement())
  name      String            @unique
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  guardians StudentGuardian[]
}

model Course {
  id          Int                 @id @default(autoincrement())
  code        String              @unique
  name        String
  group       CourseGroup
  isActive    Boolean             @default(true)
  dictId      Int?                // 新增字段
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  dict        CourseDict?         @relation(fields: [dictId], references: [id]) // 新增关联
  fees        CourseFee[]
  schedules   CourseSchedule[]
  enrollments StudentEnrollment[]
  teachers    TeacherCourse[]
}

model CourseFee {
  id            Int      @id @default(autoincrement())
  courseId      Int
  gradeId       Int
  amountCents   Int
  effectiveFrom DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  course        Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  grade         Grade    @relation(fields: [gradeId], references: [id], onDelete: Cascade)

  @@unique([courseId, gradeId])
  @@index([courseId, gradeId, effectiveFrom])
}

model CourseType {
  id         Int          @id @default(autoincrement())
  name       String       @unique
  orderIndex Int          @default(0)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  courses    CourseDict[]
}

model CourseDict {
  id         Int        @id @default(autoincrement())
  name       String
  typeId     Int
  orderIndex Int        @default(0)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  type       CourseType @relation(fields: [typeId], references: [id], onDelete: Cascade)
  courses    Course[]   // 新增反向关联

  @@unique([name, typeId])
}

model ExtraFeeType {
  id              Int               @id @default(autoincrement())
  code            String            @unique
  name            String
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  rates           ExtraFeeRate[]
  studentExtraFees StudentExtraFee[]
}

model ExtraFeeRate {
  id             Int          @id @default(autoincrement())
  extraFeeTypeId Int
  gradeId        Int
  amountCents    Int
  effectiveFrom  DateTime     @default(now())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  extraFeeType   ExtraFeeType @relation(fields: [extraFeeTypeId], references: [id], onDelete: Cascade)
  grade          Grade        @relation(fields: [gradeId], references: [id], onDelete: Cascade)

  @@index([extraFeeTypeId, gradeId, effectiveFrom])
}

model Student {
  id          String               @id @default(uuid())
  fullName    String
  gender      Gender?
  dateOfBirth DateTime?
  gradeId     Int
  schoolId    Int?
  className   String?
  address     String?
  address2    String?
  city        String?
  state       String?
  postcode    String?
  isActive    Boolean              @default(true)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  grade       Grade                @relation(fields: [gradeId], references: [id])
  school      School?              @relation(fields: [schoolId], references: [id])
  changeLogs  StudentChangeLog[]
  enrollments StudentEnrollment[]
  extraFees   StudentExtraFee[]
  guardians   StudentGuardian[]
  payments    StudentTermPayment[]
  termForceCloses StudentTermForceClose[]
}

// 学生额外费用注册记录（膳食、交通等）
model StudentExtraFee {
  id             Int          @id @default(autoincrement())
  studentId      String
  extraFeeTypeId Int
  amountCents    Int          // 注册时的金额（分）
  startTermId    Int          // 开始学期
  endTermId      Int?         // 结束学期（null表示进行中）
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  extraFeeType   ExtraFeeType @relation(fields: [extraFeeTypeId], references: [id], onDelete: Cascade)
  startTerm      Term         @relation("ExtraFeeStartTerm", fields: [startTermId], references: [id])
  endTerm        Term?        @relation("ExtraFeeEndTerm", fields: [endTermId], references: [id])

  @@unique([studentId, extraFeeTypeId, startTermId])
  @@index([studentId])
  @@index([extraFeeTypeId])
}

model StudentGuardian {
  id             Int          @id @default(autoincrement())
  studentId      String
  name           String
  relationTypeId Int
  phone          String
  isPrimary      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  relationType   GuardianType @relation(fields: [relationTypeId], references: [id])
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

model StudentEnrollment {
  id               Int      @id @default(autoincrement())
  studentId        String
  courseId         Int
  startTermId      Int
  endTermId        Int?
  customPriceCents Int?     // 学生自定义价格（分），为空则使用默认价格
  subjectCourseIds Int[]    @default([]) // 子科目标签（只用于展示，不影响价格），如补习班的华文/国文/英文/数学/科学
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  course           Course   @relation(fields: [courseId], references: [id])
  endTerm          Term?    @relation("EnrollmentEndTerm", fields: [endTermId], references: [id])
  startTerm        Term     @relation("EnrollmentStartTerm", fields: [startTermId], references: [id])
  student          Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([courseId])
  @@index([startTermId])
  @@index([endTermId])
}

model StudentTermForceClose {
  id        String   @id @default(uuid())
  studentId String
  year      Int
  termIndex Int
  note      String?
  createdAt DateTime @default(now())
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  term      Term     @relation(fields: [year, termIndex], references: [year, termIndex])

  @@unique([studentId, year, termIndex])
  @@index([studentId])
}

model StudentTermPayment {
  id         String                   @id @default(uuid())
  studentId  String
  year       Int
  termIndex  Int
  totalCents Int                      @default(0)
  paidAt     DateTime?
  note       String?
  createdAt  DateTime                 @default(now())
  updatedAt  DateTime                 @updatedAt
  student    Student                  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  term       Term                     @relation(fields: [year, termIndex], references: [year, termIndex])
  items      StudentTermPaymentItem[]
  pdfShares  ReceiptPdfShare[]

  @@unique([studentId, year, termIndex])
  @@index([year, termIndex])
}

model ReceiptPdfShare {
  token     String             @id @default(cuid())
  paymentId String
  payment   StudentTermPayment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  data      Bytes
  filename  String
  expiresAt DateTime
  createdAt DateTime           @default(now())

  @@index([paymentId])
  @@index([expiresAt])
}

model StudentTermPaymentItem {
  id          Int                @id @default(autoincrement())
  paymentId   String
  itemType    String
  refId       Int?
  description String
  unitCents   Int
  quantity    Int                @default(1)
  fraction    Float              @default(1)
  finalCents  Int
  note        String?
  createdAt   DateTime           @default(now())
  payment     StudentTermPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
}

model StudentChangeLog {
  id        String   @id @default(uuid())
  studentId String
  action    String
  before    Json?
  after     Json?
  createdAt DateTime @default(now())
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

model Teacher {
  id        String          @id @default(uuid())
  userId    String?         @unique
  name      String
  email     String?
  phone     String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  user      User?           @relation(fields: [userId], references: [id])
  courses   TeacherCourse[]
}

model TeacherCourse {
  teacherId String
  courseId  Int
  course    Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@id([teacherId, courseId])
}

model CourseSchedule {
  id        String @id @default(uuid())
  termId    Int
  courseId  Int
  dayOfWeek Int
  startTime String
  endTime   String
  course    Course @relation(fields: [courseId], references: [id])
  term      Term   @relation(fields: [termId], references: [id])

  @@index([termId])
  @@index([courseId])
}

model Notification {
  id        String              @id @default(uuid())
  channel   NotificationChannel
  target    String
  subject   String?
  body      String
  status    NotificationStatus  @default(PENDING)
  error     String?
  createdAt DateTime            @default(now())
  sentAt    DateTime?
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?
  entityName  String
  entityId    String?
  action      String
  before      String?
  after       String?
  createdAt   DateTime @default(now())
}

enum RoleCode {
  ADMIN
  RECIPIENT
  TEACHER
}

enum Gender {
  MALE
  FEMALE
}

enum CourseGroup {
  HOMEWORK
  TUITION
  WRITING
  SEC_ENGLISH
  SEC_MALAY
  SEC_MATH
  SEC_HISTORY
  SEC_EN_WRITING
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}