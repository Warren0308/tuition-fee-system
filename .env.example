# ============================================
# 数据库连接 (必填)
# ============================================
# Neon / Supabase / 自建 PostgreSQL
# 格式: postgresql://用户名:密码@主机:端口/数据库名?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# ============================================
# NextAuth.js 鉴权 (必填)
# ============================================
# 生产环境必须改为强随机字符串
# 生成方式: openssl rand -hex 32 或 node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET=replace-me-with-a-strong-random-secret

# 应用对外的完整 URL（用于回调、邮件链接、WhatsApp 分享等）
# 本地: http://localhost:3000
# 生产: https://yourdomain.com （必须是公网 HTTPS 地址）
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================
# 邮件 SMTP 配置 (可选 - 用于密码重置 / 邮件通知)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=1
SMTP_USER=
SMTP_PASS=
SMTP_FROM="优特补习学院 <noreply@example.com>"

# ============================================
# WhatsApp Business API (可选 - 拿到后填入，未配置时使用 wa.me 链接跳转)
# ============================================
# WHATSAPP_API_URL=https://graph.facebook.com/v18.0
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=

# ============================================
# 部署说明
# ============================================
# 推荐云平台：Vercel (最简单) / Railway / Render / 自建 Docker
#
# Vercel 部署步骤：
#   1. GitHub 关联仓库 → Import
#   2. 在 Environment Variables 中填入上面所有必填项
#   3. Build Command: npm run vercel-build
#   4. 部署后访问 https://your-app.vercel.app
#
# Docker 部署：
#   docker build -t tuition-fee-system .
#   docker run -p 3000:3000 --env-file .env tuition-fee-system
#
# 数据库推荐：
#   - Neon (免费额度、Serverless PostgreSQL)：https://neon.tech
#   - Supabase (免费额度)：https://supabase.com
#   - Railway (PostgreSQL 一键创建)：https://railway.app
