# ============================================
# 数据库连接 (必填)
# ============================================
# Neon / Supabase / 自建 PostgreSQL
# 格式: postgresql://用户名:密码@主机:端口/数据库名?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# ============================================
# NextAuth.js 鉴权 (必填)
# ============================================
# 生产环境必须改为强随机字符串
# 生成方式: openssl rand -hex 32
NEXTAUTH_SECRET=replace-me-with-a-strong-random-secret

# 应用对外的完整 URL（用于回调、邮件链接等）
# 本地: http://localhost:3000
# 生产: https://yourdomain.com
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================
# 邮件 SMTP 配置 (可选 - 用于密码重置 / 邮件通知)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=1
SMTP_USER=
SMTP_PASS=
SMTP_FROM="优特补习学院 <noreply@example.com>"

# ============================================
# WhatsApp Business API (暂未使用 - 拿到后填入)
# ============================================
# WHATSAPP_API_URL=
# WHATSAPP_API_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
